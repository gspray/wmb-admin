{
	"name": "wmb-admin",
	"version": "0.1.0",
	"description": "Book Platform Admin — cross-product operator application (Issue #348 Phase 4 bootstrap)",
	"main": "server.js",
	"scripts": {
		"start": "node server.js",
		"dev": "node scripts/dev-local-server.mjs --port 3018 --base-path ''",
		"dev:stop": "node scripts/dev-local-server.mjs --port 3018 --stop",
		"dev:status": "node scripts/dev-local-server.mjs --port 3018 --status",
		"test": "npm run test:admin",
		"build:frontend": "node scripts/build-admin-frontend.mjs",
		"test:admin": "node --test test/architecture/*.test.js test/services/*.test.js test/routes/*.test.js test/applications/*.test.js",
		"deploy": "bash deploy.sh",
		"deploy:admin": "bash deploy.sh",
		"deploy:server": "bash scripts/deploy-server.sh",
		"smoke:test": "node scripts/smoke-test.js",
		"smoke:admin": "node scripts/smoke-test.js",
		"lint": "node node_modules/eslint/bin/eslint.js server.js routes services middleware models scripts test eslint.config.mjs"
	},
	"dependencies": {
		"compression": "^1.7.4",
		"dotenv": "^16.4.5",
		"express": "^4.19.2",
		"firebase-admin": "^13.7.0",
		"helmet": "^7.1.0"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"esbuild": "^0.25.12",
		"eslint": "^9.39.4",
		"globals": "^17.7.0"
	},
	"engines": {
		"node": ">=20.0.0"
	},
	"license": "ISC"
}
