# wmb-admin local environment (Admin-only; no Pet/Career runtime)
# PM2 production: wmb-admin (:3018). Stage: wmb-admin-stage (:3019).
# Customer path: /admin. Orchestration APIs: /api/admin/*.
NODE_ENV=development
PORT=3018
BASE_PATH=

# Product provider base URLs (HTTP contracts only — no sibling source imports)
PET_PROVIDER_BASE_URL=http://127.0.0.1:3014/api/admin-provider/v1
CAREER_PROVIDER_BASE_URL=http://127.0.0.1:3016/api/admin-provider/v1

# Firebase (platform operator auth + admin user records during migration)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_DATABASE_URL=
FIREBASE_SERVICE_ACCOUNT=

# Admin auth
ADMIN_EMAILS=
ADMIN_DEV_USERNAME=admin
ADMIN_DEV_PASSWORD=
# ADMIN_TOKEN_SECRET=required-in-production
